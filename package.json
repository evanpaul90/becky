{
  "name": "beckyos",
  "version": "2.0.1",
  "description": "Becky \u2014 a multi-agent coding OS. 15 agents, a 14-phase SDLC, three hard gates, and loop modes that stop on runtime proof, never on an agent saying \"done.\"",
  "type": "module",
  "bin": {
    "becky": "bin/becky.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "core/",
    "agents/",
    "modes/",
    "loop/",
    "memory/",
    "wiki/",
    "templates/",
    "scripts/",
    ".claude/",
    "becky.config.yaml",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "becky": "tsx core/cli.ts",
    "compile": "tsx core/compile.ts",
    "verify": "tsx core/verify.ts",
    "init": "tsx core/cli.ts init",
    "onboard": "tsx core/cli.ts onboard",
    "learn": "tsx core/cli.ts learn",
    "greenfield": "tsx core/cli.ts greenfield",
    "brownfield": "tsx core/cli.ts brownfield",
    "run": "tsx core/cli.ts run",
    "approve": "tsx core/cli.ts approve",
    "revise": "tsx core/cli.ts revise",
    "autopilot": "tsx core/cli.ts autopilot",
    "status": "tsx core/cli.ts status",
    "assemble": "tsx core/cli.ts assemble",
    "retro": "tsx core/cli.ts retro",
    "rules:add": "tsx core/cli.ts rules add",
    "privacy": "node scripts/privacy-scan.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "ai-agents",
    "multi-agent",
    "coding-agent",
    "llm",
    "claude",
    "codex",
    "cli",
    "sdlc",
    "developer-tools",
    "becky",
    "beckyos"
  ],
  "homepage": "https://beckyos.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanpaul90/becky.git"
  },
  "bugs": {
    "url": "https://github.com/evanpaul90/becky/issues"
  },
  "author": "Evan D'Souza",
  "license": "MIT",
  "preferGlobal": true,
  "dependencies": {
    "yaml": "^2.4.0",
    "glob": "^10.3.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=18"
  }
}
